{
  "server": {
    "host": "127.0.0.1",
    "port": 8787,
    "name": "NEXUS Agent"
  },
  "ollama": {
    "base_url": "http://127.0.0.1:11434",
    "default_model": "qwen3:8b",
    "temperature": 0.25,
    "context_tokens": 8192,
    "timeout_seconds": 600,
    "keep_alive": "30s",
    "enabled": false
  },
  "agent": {
    "max_rounds": 8,
    "max_subagents": 6,
    "review_enabled": true,
    "memory_enabled": true,
    "planner_enabled": true,
    "parallel_subagents": true,
    "show_internal_trace": false,
    "max_tool_rounds": 4,
    "tool_router_enabled": true,
    "engine_router_enabled": true,
    "default_engine": "auto",
    "deerflow_complexity_threshold": "high"
  },
  "tools": {
    "filesystem_enabled": true,
    "shell_enabled": false,
    "web_fetch_enabled": true,
    "workspace_root": "./workspace",
    "browser_use_enabled": true,
    "browser_max_steps": 25,
    "mcp_enabled": true,
    "agent_reach_enabled": true
  },
  "deerflow": {
    "enabled": true,
    "base_url": "http://127.0.0.1:2026",
    "langgraph_url": "http://127.0.0.1:2026/api/langgraph",
    "assistant_id": "lead_agent",
    "default_mode": "ultra",
    "recursion_limit": 1000,
    "timeout_seconds": 1800,
    "health_timeout_seconds": 4,
    "fallback_engine": "nexus",
    "pass_model_name": false,
    "internal_auth_token_env": "DEER_FLOW_INTERNAL_AUTH_TOKEN",
    "owner_prefix": "nexus"
  },
  "knowledge": {
    "ticket_matrix_enabled": true,
    "ticket_matrix_top_k": 4,
    "official_policy_precedence": true,
    "only_when_relevant": true
  },
  "learning": {
    "enabled": true,
    "auto_capture_explicit_teaching": true,
    "max_relevant_memories": 6,
    "company_policy_requires_explicit_global_teach": true
  },
  "zendesk": {
    "enabled": true,
    "operator_mode": "copilot",
    "auto_write_ticket": false,
    "auto_send_customer_reply": false,
    "policy_source": "Ticket Matrix",
    "show_loading_percent": true
  },
  "llm": {
    "provider": "llama_cpp",
    "fallback_provider": "",
    "allow_fallback": false
  },
  "llama_cpp": {
    "base_url": "http://127.0.0.1:8080",
    "default_model": "nexus-local",
    "temperature": 0.25,
    "context_tokens": 8192,
    "max_output_tokens": 4096,
    "timeout_seconds": 600,
    "server_exe": "./runtime/llama.cpp/llama-server.exe",
    "model_path": "./models/nexus-model.gguf",
    "gpu_layers": 20,
    "threads": 8,
    "parallel": 1,
    "flash_attention": true
  }
}
